/* Vitrine Dudaocean — cartões e espaçamentos */
.product-grid {
  display: grid !important;
  grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
  gap: 22px 14px !important;
  align-items: start;
}

.product-card {
  position: relative;
  min-width: 0;
  overflow: hidden;
  border-radius: 20px !important;
  background: #fffaf6;
  border: 1px solid #eee4db;
  padding: 0 0 13px !important;
}

.product-photo-wrap {
  position: relative;
  overflow: hidden;
  border-radius: 20px 20px 0 0;
  background: #f0e6dc;
}

.product-card .product-photo {
  display: block;
  width: 100%;
  aspect-ratio: 4 / 5;
  overflow: hidden;
  background: #f0e6dc;
}

.product-card .product-photo img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform .3s ease;
}

.product-card .product-photo:active img {
  transform: scale(1.025);
}

.product-card .favorite {
  position: absolute !important;
  top: 10px;
  right: 10px;
  z-index: 3;
  display: grid;
  place-items: center;
  width: 38px;
  height: 38px;
  border: 0;
  border-radius: 50% !important;
  background: #fffaf4;
  color: #6d4d3b;
  font-size: 23px;
  box-shadow: 0 2px 12px #4a302015;
}

.demo-label,
.discount-label {
  position: absolute;
  left: 9px;
  top: 9px;
  z-index: 2;
  padding: 6px 9px;
  border-radius: 999px;
  background: #fffaf4;
  color: #735541;
  font-size: 9px;
  font-weight: 700;
  letter-spacing: .4px;
}

.discount-label {
  top: auto;
  bottom: 9px;
  background: #704b37;
  color: white;
  font-size: 11px;
}

.product-card .product-meta {
  padding: 12px 12px 8px !important;
}

.product-card .product-category {
  display: block;
  margin-bottom: 5px;
  color: #967d6a;
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: .7px;
}

.product-card .product-title {
  display: block;
  min-height: 38px;
  color: #423329;
  font-size: 13px;
  line-height: 1.45;
  font-weight: 600;
  text-decoration: none;
}

.product-card .price {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 7px;
  margin-top: 8px;
  color: #493326;
  font-size: 17px;
  font-weight: 700;
}

.product-card .old-price {
  color: #9b8c80;
  font-size: 11px;
  font-weight: 400;
  text-decoration: line-through;
}

.demo-price-note {
  display: block;
  margin-top: 5px;
  color: #927a68;
  font-size: 10px;
  line-height: 1.4;
}

.product-card .quick-add {
  display: block;
  width: calc(100% - 24px);
  min-height: 42px;
  margin: 5px 12px 0 !important;
  padding: 10px !important;
  border: 1px solid #765541 !important;
  border-radius: 999px !important;
  background: #765541 !important;
  color: #fffaf6 !important;
  font-size: 11px;
  font-weight: 600;
}

.product-card .quick-add:disabled {
  opacity: .5;
}

.photo-placeholder,
.product-photo.no-photo {
  display: grid;
  place-items: center;
  color: #8e7562;
  background: #f0e6dc;
}

@media (min-width: 700px) {
  .product-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
    gap: 28px !important;
  }
}

@media (min-width: 1000px) {
  .product-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
  }
}

@media (max-width: 360px) {
  .product-grid {
    gap: 12px 9px !important;
  }

  .product-card .product-meta {
    padding: 10px 9px 7px !important;
  }

  .product-card .quick-add {
    width: calc(100% - 18px);
    margin: 5px 9px 0 !important;
    font-size: 10px;
  }
}

/* Página de produto com acabamento arredondado */
.product-page {
  max-width: 1240px !important;
  padding-top: 28px !important;
}

.gallery-main {
  border-radius: 22px !important;
  background: #f3ebe3 !important;
}

.gallery-thumbs button {
  border-radius: 14px !important;
}

.detail-price {
  color: #513a2b;
  font-size: clamp(26px, 4vw, 34px) !important;
}

.detail-actions {
  grid-template-columns: 1fr !important;
}

.detail-actions button {
  min-height: 48px;
  border-radius: 999px !important;
}

.review-card {
  padding: 20px;
  margin: 12px 0;
  border: 1px solid #eee4db;
  border-radius: 18px;
  background: #fffaf6;
}

@media (max-width: 720px) {
  .product-page {
    padding: 20px 14px 100px !important;
  }

  .detail-grid {
    grid-template-columns: 1fr !important;
    gap: 22px !important;
  }

  .gallery-main {
    aspect-ratio: 1 / 1.05;
  }

  .detail-info h1 {
    font-size: 29px !important;
  }
}



/* Correções visuais Dudaocean */
.duda-brand-fixed,
.brand.duda-brand-fixed {
  display: inline-flex;
  align-items: center;
  justify-content: flex-start;
  flex: 0 0 auto;
  min-width: 0;
  overflow: visible;
}
.duda-logo-image {
  display: block;
  width: clamp(118px, 31vw, 172px);
  height: 58px;
  max-width: none;
  object-fit: contain;
  object-position: left center;
  flex-shrink: 0;
}
#cartOpen {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  overflow: visible;
  flex-shrink: 0;
  min-width: 42px;
  min-height: 42px;
  padding: 7px;
  border-radius: 50%;
}
#cartOpen img,
#accountBtn img {
  display: block;
  width: 27px;
  height: 27px;
  max-width: none;
  object-fit: contain;
  object-position: center;
  border-radius: 0;
  overflow: visible;
}
#cartOpen .cart-count,
#cartOpen .cart-counter,
#cartOpen [data-cart-count] {
  line-height: 1;
}

/* Categorias organizadas em grade: não precisa arrastar para os lados. */
#categoryPills {
  display: grid !important;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 9px;
  width: 100%;
  max-width: 760px;
  margin-inline: auto;
  overflow: visible !important;
  white-space: normal !important;
  padding: 4px 0 12px;
}
#categoryPills > * {
  min-width: 0;
  width: 100%;
  min-height: 42px;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  white-space: normal;
  overflow-wrap: anywhere;
  border-radius: 999px;
  margin: 0 !important;
}
@media (min-width: 600px) {
  #categoryPills {
    grid-template-columns: repeat(6, minmax(0, 1fr));
  }
}
@media (max-width: 360px) {
  #categoryPills {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}
.product-photo img,
.product-image img,
.product-card img {
  max-width: 100%;
}
.detail-gallery {
  min-width: 0;
}
.detail-main-image {
  position: relative;
  width: 100%;
  overflow: hidden;
  border-radius: 18px;
  background: #f5f0eb;
}
.detail-main-image > img {
  display: block;
  width: 100%;
  aspect-ratio: 4 / 5;
  object-fit: cover;
}
.demo-label {
  position: absolute;
  left: 12px;
  top: 12px;
  padding: 7px 10px;
  border-radius: 999px;
  background: #fffaf5;
  color: #765b49;
  font-size: 10px;
  letter-spacing: .07em;
}
.gallery-thumbs {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 10px;
}
.gallery-thumb {
  width: 66px;
  height: 78px;
  padding: 0;
  overflow: hidden;
  border: 1px solid #e4d8ce;
  border-radius: 10px;
  background: #f5f0eb;
}
.gallery-thumb img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.gallery-thumb.active {
  border: 2px solid #92735e;
}
.detail-info {
  min-width: 0;
  padding: 8px 0;
}
.detail-info h1 {
  margin: 8px 0 14px;
  color: #403329;
  font-size: clamp(26px, 5vw, 38px);
  line-height: 1.15;
}
.detail-prices {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 12px;
  margin: 12px 0;
}
.detail-prices strong {
  color: #403329;
  font-size: 25px;
}
.detail-prices del {
  color: #958579;
  font-size: 15px;
}
.demo-disclaimer,
.detail-note {
  color: #89796d;
  font-size: 12px;
  line-height: 1.6;
}
.detail-description {
  color: #6e5d51;
  line-height: 1.8;
  margin: 18px 0;
}
.detail-actions {
  display: grid;
  grid-template-columns: 1fr;
  gap: 10px;
  margin-top: 22px;
}
.detail-actions button {
  width: 100%;
  min-height: 48px;
  border-radius: 999px;
}
.detail-no-image {
  aspect-ratio: 4 / 5;
  display: grid;
  place-items: center;
  color: #8b7564;
}
@media (min-width: 700px) {
  .detail-actions {
    grid-template-columns: 1fr 1fr;
  }
}
@media (max-width: 420px) {
  .duda-logo-image {
    width: 108px;
    height: 48px;
  }
  #cartOpen img,
  #accountBtn img {
    width: 25px;
    height: 25px;
  }
}





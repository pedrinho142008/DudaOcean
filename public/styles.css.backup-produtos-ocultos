/* ==========================================
   DUDaocean — SACOLA E PRODUTOS RESPONSIVOS
   ========================================== */
html, body {
  max-width: 100%;
  overflow-x: clip;
}
*, *::before, *::after {
  box-sizing: border-box;
}
img {
  max-width: 100%;
}

/* Sacola: painel adaptável */
#cartDrawer, #cartModal, #cartPanel, #cartOverlay,
.cart-drawer, .cart-modal, .cart-panel, .cart-overlay {
  box-sizing: border-box;
}
#cartDrawer, .cart-drawer {
  position: fixed;
  z-index: 10000;
  top: 0;
  right: 0;
  bottom: 0;
  width: min(440px, 100vw);
  max-width: 100%;
  height: 100vh;
  height: 100dvh;
  padding: 0;
  overflow: hidden;
}
#cartDrawer.open, .cart-drawer.open,
#cartDrawer.active, .cart-drawer.active {
  display: flex;
  flex-direction: column;
}
#cartModal, .cart-modal, #cartPanel, .cart-panel {
  max-width: calc(100vw - 24px);
  max-height: calc(100dvh - 24px);
  overflow: hidden;
}
#cartItems, .cart-items, #cartItemsList {
  min-width: 0;
  overflow-x: hidden;
  overflow-y: auto;
  overscroll-behavior: contain;
  -webkit-overflow-scrolling: touch;
}
#cartItems > *, .cart-items > *, #cartItemsList > * {
  min-width: 0;
  max-width: 100%;
}

/* Mantém o conteúdo da sacola organizado em coluna. */

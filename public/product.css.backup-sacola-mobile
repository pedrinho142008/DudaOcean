/* Correções visuais Dudaocean */
.duda-brand-fixed,
.brand.duda-brand-fixed {
  display: inline-flex;
  align-items: center;
  justify-content: flex-start;
  flex: 0 0 auto;
  min-width: 0;
  overflow: visible;
}
.duda-logo-image {
  display: block;
  width: clamp(118px, 31vw, 172px);
  height: 58px;
  max-width: none;
  object-fit: contain;
  object-position: left center;
  flex-shrink: 0;
}
#cartOpen {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  overflow: visible;
  flex-shrink: 0;
  min-width: 42px;
  min-height: 42px;
  padding: 7px;
  border-radius: 50%;
}
#cartOpen img,
#accountBtn img {
  display: block;
  width: 27px;
  height: 27px;
  max-width: none;
  object-fit: contain;
  object-position: center;
  border-radius: 0;
  overflow: visible;
}
#cartOpen .cart-count,
#cartOpen .cart-counter,
#cartOpen [data-cart-count] {
  line-height: 1;
}

/* Categorias organizadas em grade: não precisa arrastar para os lados. */
#categoryPills {
  display: grid !important;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 9px;
  width: 100%;
  max-width: 760px;
  margin-inline: auto;
  overflow: visible !important;
  white-space: normal !important;
  padding: 4px 0 12px;
}
#categoryPills > * {
  min-width: 0;
  width: 100%;
  min-height: 42px;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  white-space: normal;
  overflow-wrap: anywhere;
  border-radius: 999px;
  margin: 0 !important;
}
@media (min-width: 600px) {
  #categoryPills {
    grid-template-columns: repeat(6, minmax(0, 1fr));
  }
}
@media (max-width: 360px) {
  #categoryPills {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}
.product-photo img,
.product-image img,
.product-card img {
  max-width: 100%;
}
.detail-gallery {
  min-width: 0;
}
.detail-main-image {
  position: relative;
  width: 100%;
  overflow: hidden;
  border-radius: 18px;
  background: #f5f0eb;
}
.detail-main-image > img {
  display: block;
  width: 100%;
  aspect-ratio: 4 / 5;
  object-fit: cover;
}
.demo-label {
  position: absolute;
  left: 12px;
  top: 12px;
  padding: 7px 10px;
  border-radius: 999px;
  background: #fffaf5;
  color: #765b49;
  font-size: 10px;
  letter-spacing: .07em;
}
.gallery-thumbs {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 10px;
}
.gallery-thumb {
  width: 66px;
  height: 78px;
  padding: 0;
  overflow: hidden;
  border: 1px solid #e4d8ce;
  border-radius: 10px;
  background: #f5f0eb;
}
.gallery-thumb img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.gallery-thumb.active {
  border: 2px solid #92735e;
}
.detail-info {
  min-width: 0;
  padding: 8px 0;
}
.detail-info h1 {
  margin: 8px 0 14px;
  color: #403329;
  font-size: clamp(26px, 5vw, 38px);
  line-height: 1.15;
}
.detail-prices {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 12px;
  margin: 12px 0;
}
.detail-prices strong {
  color: #403329;
  font-size: 25px;
}
.detail-prices del {
  color: #958579;
  font-size: 15px;
}
.demo-disclaimer,
.detail-note {
  color: #89796d;
  font-size: 12px;
  line-height: 1.6;
}
.detail-description {
  color: #6e5d51;
  line-height: 1.8;
  margin: 18px 0;
}
.detail-actions {
  display: grid;
  grid-template-columns: 1fr;
  gap: 10px;
  margin-top: 22px;
}
.detail-actions button {
  width: 100%;
  min-height: 48px;
  border-radius: 999px;
}
.detail-no-image {
  aspect-ratio: 4 / 5;
  display: grid;
  place-items: center;
  color: #8b7564;
}
@media (min-width: 700px) {
  .detail-actions {
    grid-template-columns: 1fr 1fr;
  }
}
@media (max-width: 420px) {
  .duda-logo-image {
    width: 108px;
    height: 48px;
  }
  #cartOpen img,
  #accountBtn img {
    width: 25px;
    height: 25px;
  }
}




/* Vitrine Dudaocean: alinhamento e responsividade */
#productGrid {
  display: grid !important;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: clamp(10px, 2.8vw, 22px);
  align-items: stretch;
  width: 100%;
  min-width: 0;
  margin: 0 auto;
}
#productGrid > * {
  min-width: 0;
  max-width: 100%;
}
#productGrid .product-card {
  display: flex;
  flex-direction: column;
  min-width: 0;
  height: 100%;
  overflow: hidden;
  border-radius: 16px;
  background: #fffdfb;
  border: 1px solid #eee5dc;
  box-shadow: 0 4px 16px rgba(76, 52, 34, .045);
}
#productGrid .product-photo {
  position: relative;
  display: block;
  width: 100%;
  aspect-ratio: 4 / 5;
  overflow: hidden;
  background: #f4eee8;
  border-radius: 0;
}
#productGrid .product-photo img,
#productGrid .product-image img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform .35s ease;
}
#productGrid .product-card:hover .product-photo img {
  transform: scale(1.025);
}
#productGrid .product-info,
#productGrid .product-content {
  display: flex;
  flex: 1 1 auto;
  flex-direction: column;
  align-items: flex-start;
  gap: 7px;
  padding: 12px;
  min-width: 0;
}
#productGrid .product-title,
#productGrid .product-name,
#productGrid h3 {
  max-width: 100%;
  margin: 0;
  color: #49382d;
  font-size: clamp(13px, 3.5vw, 16px);
  line-height: 1.4;
  overflow-wrap: anywhere;
}
#productGrid .product-price,
#productGrid .price {
  font-size: 16px;
  font-weight: 700;
  color: #62452f;
}
#productGrid .product-category {
  font-size: 11px;
  letter-spacing: .04em;
  color: #927e6d;
}
#productGrid [data-add] {
  width: 100%;
  min-height: 40px;
  margin-top: auto;
  padding: 9px 10px;
  border-radius: 999px;
  font-size: 12px;
  line-height: 1.3;
  white-space: normal;
}
#productGrid [data-favorite] {
  z-index: 3;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 38px;
  height: 38px;
  min-width: 38px;
  padding: 0;
  border: 1px solid #eee0d5;
  border-radius: 50%;
  background: rgba(255, 253, 250, .96);
  color: #75553f;
  font-size: 23px;
  line-height: 1;
  box-shadow: 0 2px 9px rgba(65, 45, 30, .08);
  cursor: pointer;
}
#productGrid [data-favorite].is-favorite {
  color: #a44f5a;
  background: #fff5f5;
  border-color: #ead0d0;
}
#productGrid .demo-label,
#productGrid .product-demo-label {
  max-width: calc(100% - 12px);
  font-size: 9px;
  letter-spacing: .03em;
}
#dudaStoreToast {
  position: fixed;
  z-index: 99999;
  left: 50%;
  bottom: calc(22px + env(safe-area-inset-bottom, 0px));
  width: max-content;
  max-width: calc(100vw - 32px);
  padding: 13px 18px;
  border: 1px solid #e7d8ca;
  border-radius: 14px;
  background: #fffaf5;
  color: #62452f;
  box-shadow: 0 8px 30px rgba(45, 30, 20, .16);
  font-size: 14px;
  line-height: 1.4;
  opacity: 0;
  visibility: hidden;
  transform: translate(-50%, 12px);
  transition: opacity .2s ease, transform .2s ease, visibility .2s ease;
  pointer-events: none;
}
#dudaStoreToast.visible {
  opacity: 1;
  visibility: visible;
  transform: translate(-50%, 0);
}
.product-back-wrap {
  width: 100%;
  max-width: 1200px;
  margin: 0 auto;
  padding: 16px clamp(14px, 4vw, 28px) 0;
  box-sizing: border-box;
}
.product-back-link {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 9px;
  min-height: 40px;
  padding: 8px 15px;
  border: 1px solid #e7d9cc;
  border-radius: 999px;
  background: #fffaf5;
  color: #72513d;
  text-decoration: none;
  font-size: 13px;
  font-weight: 600;
}
.product-back-link span {
  font-size: 19px;
  line-height: 1;
}
.product-back-floating {
  position: fixed;
  z-index: 100;
  left: 14px;
  top: calc(12px + env(safe-area-inset-top, 0px));
  box-shadow: 0 3px 12px rgba(60, 40, 25, .1);
}
@media (min-width: 650px) {
  #productGrid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
}
@media (min-width: 1000px) {
  #productGrid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 22px;
  }
}
@media (max-width: 360px) {
  #productGrid {
    gap: 8px;
  }
  #productGrid .product-info,
  #productGrid .product-content {
    padding: 9px;
  }
  #productGrid [data-add] {
    font-size: 11px;
    padding-inline: 6px;
  }
}
@media (prefers-reduced-motion: reduce) {
  #productGrid .product-photo img,
  #dudaStoreToast {
    transition: none;
  }
}


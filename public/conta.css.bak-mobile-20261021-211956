:root {
  color-scheme: light;
  --bg:#f7f2ec;
  --paper:#fffdf9;
  --ink:#332820;
  --muted:#84766b;
  --line:#e8ddd1;
  --brown:#75543f;
  --brown-dark:#4e382b;
  --soft:#eee4d9;
}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font-family:Arial,Helvetica,sans-serif}
button,input{font:inherit}
a{color:inherit;text-decoration:none}
button{cursor:pointer}
.topbar{height:76px;padding:0 clamp(18px,5vw,76px);display:flex;align-items:center;justify-content:space-between;background:var(--paper);border-bottom:1px solid var(--line)}
.brand{font-family:Georgia,serif;font-size:30px;letter-spacing:-1.5px;font-weight:700}
.brand span{color:#a9876d}
.back-link,.outline{border:1px solid var(--line);border-radius:999px;padding:11px 16px;background:transparent;color:var(--brown-dark);font-size:14px}
.page{max-width:1200px;margin:auto;padding:clamp(24px,5vw,64px) clamp(16px,4vw,36px)}
.auth-layout{display:grid;grid-template-columns:1fr minmax(300px,440px);align-items:center;gap:clamp(28px,7vw,100px);min-height:65vh}
.auth-intro h1,.welcome h1{font-family:Georgia,serif;font-weight:400;font-size:clamp(36px,5vw,62px);line-height:1.08;margin:16px 0}
.auth-intro h1 em{color:#a17b5e}
.auth-intro p,.muted{color:var(--muted);line-height:1.7}
.eyebrow{font-size:11px;letter-spacing:2px;color:#9a775c;font-weight:700}
.auth-card,.content-card{background:var(--paper);border:1px solid var(--line);border-radius:22px;padding:clamp(22px,4vw,36px);box-shadow:0 12px 40px #49352208}
.auth-card h2,.content-card h2{font-family:Georgia,serif;font-weight:400;font-size:30px;margin:12px 0}
.auth-card form{display:grid;gap:16px;margin-top:25px}
label{display:grid;gap:8px;font-size:13px;color:var(--brown-dark)}
input{width:100%;min-width:0;border:1px solid var(--line);border-radius:11px;background:white;padding:14px;color:var(--ink);outline:none}
input:focus{border-color:#a9876d;box-shadow:0 0 0 3px #a9876d20}
.primary{width:100%;padding:14px;border:0;border-radius:999px;background:var(--brown-dark);color:white;font-weight:600}
.primary:disabled{opacity:.6;cursor:wait}
.text-button{display:block;margin:17px auto 0;border:0;background:none;color:var(--brown);font-size:13px;text-decoration:underline;text-underline-offset:3px}
.message{font-size:13px;line-height:1.6;color:var(--brown);overflow-wrap:anywhere}
.hidden{display:none!important}
.welcome{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:30px}
.welcome h1{font-size:clamp(34px,4vw,48px);margin-bottom:8px}
.account-grid{display:grid;grid-template-columns:240px minmax(0,1fr);gap:22px;align-items:start}
.side-nav{display:grid;gap:6px;padding:10px;background:#efe6dc;border-radius:18px}
.nav-item{display:block;width:100%;text-align:left;border:0;background:transparent;color:var(--brown-dark);padding:13px 14px;border-radius:11px;font-size:14px}
.nav-item.active{background:var(--paper);font-weight:700;box-shadow:0 2px 8px #49352208}
.store-link{border-top:1px solid #ddcfc0;margin-top:6px;padding-top:18px}
.content-card{min-height:330px}
.content-card h2{margin-top:0}
.content-card h3{font-family:Georgia,serif;font-size:22px;font-weight:400}
.content-card p{line-height:1.7}
.stats{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin:24px 0}
.stat{border:1px solid var(--line);border-radius:14px;padding:18px}
.stat strong{display:block;font-family:Georgia,serif;font-size:28px;font-weight:400}
.stat span{display:block;margin-top:6px;color:var(--muted);font-size:12px}
.action-row{display:flex;flex-wrap:wrap;gap:10px;margin-top:20px}
.outline{cursor:pointer}
.action-row .outline{background:var(--paper)}
.profile-form{display:grid;gap:15px;max-width:520px}
.product-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
.product-item{border:1px solid var(--line);border-radius:14px;padding:15px;overflow-wrap:anywhere}
.product-item strong{display:block;margin-bottom:8px}
.product-item p{font-size:13px;color:var(--muted)}
.product-item button{border:0;background:none;color:var(--brown);padding:5px 0;text-decoration:underline}
.empty{padding:28px 10px;text-align:center;color:var(--muted);border:1px dashed var(--line);border-radius:14px}
.toast{position:fixed;left:50%;bottom:24px;transform:translate(-50%,20px);opacity:0;pointer-events:none;background:var(--brown-dark);color:white;padding:13px 20px;border-radius:999px;max-width:calc(100% - 32px);font-size:13px;transition:.2s;z-index:5}
.toast.show{opacity:1;transform:translate(-50%,0)}
@media(max-width:760px){
 .auth-layout{grid-template-columns:1fr;gap:24px;min-height:auto}
 .auth-intro h1{font-size:40px;margin:12px 0}
 .auth-intro p{margin-bottom:0}
 .account-grid{grid-template-columns:1fr}
 .side-nav{display:flex;overflow-x:auto;gap:6px;padding:8px;border-radius:13px}
 .nav-item{width:auto;min-width:max-content;text-align:center;padding:12px}
 .store-link{border-top:0;margin-top:0;padding-top:12px}
 .welcome{align-items:flex-start}
 .welcome .outline{white-space:nowrap}
 .content-card{padding:22px 17px}
}
@media(max-width:400px){.brand{font-size:26px}.back-link{font-size:12px;padding:10px}.product-list,.stats{grid-template-columns:1fr}.welcome{flex-direction:column}}

/* DUDAOCEAN — CLEAN EDITORIAL REDESIGN */
:root {
  --bg: #faf7f2;
  --paper: #fffefa;
  --ink: #382e27;
  --muted: #95877a;
  --line: #eee6dd;
  --brown: #92715a;
  --brown-dark: #49372b;
  --soft: #f2eae1;
}

body {
  background:
    radial-gradient(ellipse at 8% 0%, #f0e5d8 0, transparent 35%),
    var(--bg);
  letter-spacing: .01em;
  -webkit-font-smoothing: antialiased;
}

.topbar {
  height: 82px;
  background: rgba(255, 254, 250, .82);
  backdrop-filter: blur(18px);
  border-bottom: 1px solid rgba(160, 133, 109, .12);
}

.brand {
  font-size: 32px;
  letter-spacing: -1.8px;
}

.brand span {
  color: #b18d70;
}

.back-link,
.outline {
  border-radius: 999px;
  border-color: #e8ddd1;
  padding: 12px 19px;
  transition: background .2s, transform .2s, border-color .2s;
}

.back-link:hover,
.outline:hover {
  background: #f1e8de;
  border-color: #d9c7b5;
  transform: translateY(-1px);
}

.page {
  max-width: 1320px;
  padding-top: clamp(30px, 6vw, 76px);
  padding-bottom: 80px;
}

.auth-layout {
  gap: clamp(32px, 8vw, 125px);
}

.auth-intro h1,
.welcome h1 {
  font-family: Georgia, "Times New Roman", serif;
  letter-spacing: -1.8px;
  line-height: 1.08;
}

.auth-intro h1 {
  font-size: clamp(43px, 6vw, 76px);
}

.auth-intro h1 em {
  color: #a58265;
  font-weight: 400;
}

.auth-intro p {
  max-width: 380px;
  font-size: 15px;
}

.eyebrow {
  letter-spacing: 2.4px;
  font-size: 10px;
  color: #a18469;
}

.auth-card,
.content-card {
  border: 1px solid rgba(221, 207, 192, .52);
  border-radius: 30px;
  background: rgba(255, 254, 250, .86);
  box-shadow: 0 18px 60px rgba(78, 55, 36, .035);
}

.auth-card {
  padding: clamp(27px, 4vw, 43px);
}

.auth-card h2,
.content-card h2 {
  font-family: Georgia, "Times New Roman", serif;
  letter-spacing: -.7px;
  font-size: 32px;
}

.auth-card form {
  gap: 19px;
}

label {
  gap: 9px;
  color: #766558;
  font-size: 12px;
  letter-spacing: .025em;
}

input {
  border: 1px solid #eee5dc;
  border-radius: 15px;
  padding: 15px 16px;
  background: #fffefa;
  transition: border-color .2s, box-shadow .2s, background .2s;
}

input:focus {
  border-color: #b79a80;
  background: #fff;
  box-shadow: 0 0 0 4px rgba(183, 154, 128, .11);
}

.primary {
  border-radius: 999px;
  padding: 15px 20px;
  background: #49372b;
  letter-spacing: .025em;
  transition: transform .2s, background .2s, box-shadow .2s;
}

.primary:hover {
  background: #624a39;
  box-shadow: 0 7px 20px rgba(73, 55, 43, .12);
  transform: translateY(-1px);
}

.text-button {
  color: #8d6e56;
  line-height: 1.7;
}

.dashboard {
  animation: accountFade .35s ease both;
}

@keyframes accountFade {
  from { opacity: 0; transform: translateY(8px); }
  to { opacity: 1; transform: translateY(0); }
}

.welcome {
  padding: 10px 0 30px;
  margin-bottom: 20px;
  border-bottom: 1px solid #eae0d6;
}

.welcome h1 {
  font-size: clamp(38px, 5vw, 57px);
  margin-top: 13px;
}

.welcome .muted {
  font-size: 13px;
}

.account-grid {
  grid-template-columns: 235px minmax(0, 1fr);
  gap: clamp(20px, 4vw, 54px);
}

.side-nav {
  position: sticky;
  top: 18px;
  display: flex;
  flex-direction: column;
  gap: 5px;
  padding: 0;
  background: transparent;
  border-radius: 0;
}

.nav-item {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 46px;
  padding: 12px 17px;
  border-radius: 999px;
  color: #877568;
  background: transparent;
  transition: background .2s, color .2s, padding .2s;
}

.nav-item:hover {
  background: rgba(236, 225, 213, .52);
  color: #49372b;
}

.nav-item.active {
  background: #eee4d9;
  color: #49372b;
  font-weight: 600;
  box-shadow: none;
}

.nav-item.active::before {
  content: "";
  position: absolute;
  left: 7px;
  height: 5px;
  width: 5px;
  border-radius: 50%;
  background: #9b785d;
}

.store-link {
  margin-top: 14px;
  padding-top: 14px;
  border-top: 1px solid #e9dfd5;
  border-radius: 0;
}

.content-card {
  min-height: 390px;
  padding: clamp(25px, 4vw, 46px);
}

.content-card h2 {
  margin-bottom: 10px;
}

.content-card h3 {
  font-size: 24px;
  letter-spacing: -.4px;
}

.stats {
  gap: 14px;
}

.stat {
  border: 0;
  border-radius: 22px;
  background: #f5eee6;
  padding: 23px;
}

.stat strong {
  font-family: Georgia, "Times New Roman", serif;
  font-size: 35px;
  color: #6e5140;
}

.stat span {
  line-height: 1.6;
  color: #8f7e70;
}

.product-list {
  gap: 14px;
}

.product-item {
  border: 1px solid #eee4da;
  border-radius: 20px;
  background: #fffefa;
  padding: 19px;
  transition: border-color .2s, transform .2s;
}

.product-item:hover {
  border-color: #d9c5b2;
  transform: translateY(-2px);
}

.product-item button {
  border-radius: 999px;
}

.empty {
  border: 1px dashed #e1d4c7;
  border-radius: 22px;
  padding: 35px 22px;
  line-height: 1.8;
  background: rgba(248, 242, 235, .45);
}

.message {
  line-height: 1.7;
}

.toast {
  border: 1px solid rgba(255,255,255,.1);
  box-shadow: 0 12px 35px rgba(49, 35, 25, .17);
  padding: 14px 22px;
}

@media (min-width: 761px) {
  .dashboard .content-card {
    border-radius: 30px;
  }
}

@media (max-width: 760px) {
  .topbar {
    height: 70px;
    padding-inline: 18px;
  }

  .brand {
    font-size: 28px;
  }

  .page {
    padding: 28px 17px 55px;
  }

  .auth-intro h1 {
    font-size: clamp(39px, 11vw, 53px);
  }

  .auth-card {
    border-radius: 26px;
    padding: 25px 21px;
  }

  .welcome {
    padding-bottom: 22px;
    margin-bottom: 17px;
    gap: 15px;
  }

  .welcome h1 {
    font-size: 37px;
    letter-spacing: -1px;
  }

  .account-grid {
    gap: 20px;
  }

  .side-nav {
    position: static;
    flex-direction: row;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    padding: 3px 0 9px;
    gap: 7px;
  }

  .side-nav::-webkit-scrollbar {
    display: none;
  }

  .nav-item {
    flex: 0 0 auto;
    min-height: 40px;
    width: auto;
    min-width: max-content;
    padding: 10px 16px;
    background: #f1e9e0;
    font-size: 12px;
  }

  .nav-item.active::before {
    display: none;
  }

  .store-link {
    margin-top: 0;
    border: 0;
    border-radius: 999px;
  }

  .content-card {
    min-height: 330px;
    border-radius: 25px;
    padding: 25px 20px;
  }

  .stat {
    border-radius: 18px;
    padding: 19px;
  }

  .product-item {
    border-radius: 17px;
  }
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: .01ms !important;
    transition-duration: .01ms !important;
    scroll-behavior: auto !important;
  }
}
